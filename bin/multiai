#!/usr/bin/env bash
# ==============================================================================
# MultiAI CLI Launcher
# ==============================================================================
# Launches MultiAI backend with the current working directory as the workspace.
# Designed to be symlinked into ~/.local/bin/multiai or /usr/local/bin/multiai.
# Supports editing config ('multiai conf') and models ('multiai models') via $EDITOR.
# ==============================================================================

set -e

# Capture caller working directory as target workspace (gracefully fallback if cwd was unlinked)
TARGET_WORKSPACE="$(pwd -P 2>/dev/null || pwd 2>/dev/null || true)"
if [ -z "$TARGET_WORKSPACE" ] || [ ! -d "$TARGET_WORKSPACE" ]; then
  TARGET_WORKSPACE="$HOME"
fi

# Resolve physical path to this script, resolving symlink chains
SOURCE="${BASH_SOURCE[0]}"
while [ -L "$SOURCE" ]; do
  SCRIPT_DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ $SOURCE != /* ]] && SOURCE="$SCRIPT_DIR/$SOURCE"
done
MULTIAI_DIR="$(cd -P "$(dirname "$SOURCE")/.." >/dev/null 2>&1 && pwd)"

if [ ! -f "$MULTIAI_DIR/start.py" ]; then
  echo "Error: MultiAI installation not found at $MULTIAI_DIR" >&2
  exit 1
fi

resolve_editor() {
  local ed="${EDITOR:-${VISUAL:-}}"
  if [ -n "$ed" ]; then
    echo "$ed"
    return
  fi
  for cand in nano vim vi; do
    if command -v "$cand" >/dev/null 2>&1; then
      echo "$cand"
      return
    fi
  done
  echo "nano"
}

resolve_user_home() {
  if [ -n "$MULTIAI_HOME" ] && [ -d "$MULTIAI_HOME" ]; then
    echo "$MULTIAI_HOME"
    return
  fi
  local termux_home="/data/data/com.termux/files/home"
  if [ -n "$TERMUX_VERSION" ] || [ -d "$termux_home" ]; then
    if [ -n "$HOME" ] && [[ "$HOME" == *"/files/home"* ]] && [ -d "$HOME" ]; then
      echo "$HOME"
      return
    fi
    if [ -d "$termux_home" ]; then
      echo "$termux_home"
      return
    fi
    local alt_termux_home="/data/user/0/com.termux/files/home"
    if [ -d "$alt_termux_home" ]; then
      echo "$alt_termux_home"
      return
    fi
    if [ -n "$TERMUX_VERSION" ]; then
      echo "$termux_home"
      return
    fi
  fi
  if [ -n "$HOME" ] && [ "$HOME" != "/" ] && [ "$HOME" != "/data" ] && [ "$HOME" != "/data/user/0/com.termux" ] && [ -d "$HOME" ]; then
    echo "$HOME"
    return
  fi
  echo "${HOME:-/tmp}"
}

USER_HOME="$(resolve_user_home)"
export MULTIAI_HOME="$USER_HOME"

resolve_config_path() {
  if [ -n "$MULTIAI_CONFIG_PATH" ]; then
    echo "$MULTIAI_CONFIG_PATH"
    return
  fi
  local user_dir="$USER_HOME/.MultiAI"
  local user_cfg="$user_dir/config.ini"
  if [ -s "$user_cfg" ]; then
    echo "$user_cfg"
    return
  fi
  mkdir -p "$user_dir" 2>/dev/null || true
  local root_cfg="$MULTIAI_DIR/config.ini"
  local example_cfg="$MULTIAI_DIR/config.example.ini"
  for cand in "$root_cfg" "$example_cfg"; do
    if [ -f "$cand" ]; then
      cp "$cand" "$user_cfg" 2>/dev/null || true
      if [ -s "$user_cfg" ]; then
        echo "$user_cfg"
        return
      fi
    fi
  done
  echo "$user_cfg"
}

resolve_models_path() {
  if [ -n "$MULTIAI_MODELS_PATH" ]; then
    echo "$MULTIAI_MODELS_PATH"
    return
  fi
  local user_dir="$USER_HOME/.MultiAI"
  local user_models="$user_dir/models.yaml"
  if [ -s "$user_models" ]; then
    echo "$user_models"
    return
  fi
  mkdir -p "$user_dir" 2>/dev/null || true
  local root_models="$MULTIAI_DIR/models.yaml"
  if [ -f "$root_models" ]; then
    cp "$root_models" "$user_models" 2>/dev/null || true
    if [ -s "$user_models" ]; then
      echo "$user_models"
      return
    fi
  fi
  echo "$user_models"
}

# Subcommands: configuration and models file editing via $EDITOR
case "$1" in
  conf|config)
    shift
    EDITOR_BIN="$(resolve_editor)"
    TARGET_FILE="$(resolve_config_path)"
    echo -e "\033[96m[MultiAI]\033[0m Opening configuration in $EDITOR_BIN: $TARGET_FILE"
    exec $EDITOR_BIN "$TARGET_FILE" "$@"
    ;;
  models|model)
    shift
    EDITOR_BIN="$(resolve_editor)"
    TARGET_FILE="$(resolve_models_path)"
    echo -e "\033[96m[MultiAI]\033[0m Opening models configuration in $EDITOR_BIN: $TARGET_FILE"
    exec $EDITOR_BIN "$TARGET_FILE" "$@"
    ;;
esac

# Detect Python 3 executable
PYTHON_BIN="python3"
if ! command -v python3 >/dev/null 2>&1; then
  if command -v python >/dev/null 2>&1; then
    PYTHON_BIN="python"
  else
    echo "Error: Python 3 is required but was not found in PATH." >&2
    exit 1
  fi
fi

# Export workspace and configuration environment variables
export MULTIAI_REPO_DIR="$MULTIAI_DIR"
export MULTIAI_WORKSPACE_DIR="$TARGET_WORKSPACE"
export MULTIAI_CONFIG_PATH="$(resolve_config_path)"
export MULTIAI_MODELS_PATH="$(resolve_models_path)"

# Execute Universal Starter in workspace
exec "$PYTHON_BIN" "$MULTIAI_DIR/start.py" --workspace "$TARGET_WORKSPACE" "$@"
